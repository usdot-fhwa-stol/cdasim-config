# This env file is built into the carma config image and contains only image version
# variables to pass into carma config docker compose.
# NOTE: Editing this file locally without rebuilding carma config image will have no impact
# NOTE: DOCKER_ORG/DOCKER_TAG are used by docker-compose.yml for carma-platform,
# carma-carla-integration and scenario-runner, and by the carma CLI to find the
# platform image. Other images (carla, v2x-ros-driver, web-ui) are hardcoded;
# see docker-compose.yml and docker-compose-background.yml directly.
DOCKER_TAG=trb-2027
DOCKER_ORG=usdotfhwastolcandidate
SIMULATION_SCENARIO=Trb2027_1
# OPS_DOCKER_TAG=develop # Commented out as it is currently unused since we are using hardcoded versions. Use if needed for PHP or V2XHub in docker-compose accordingly.